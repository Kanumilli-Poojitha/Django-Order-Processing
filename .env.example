# Copy this file to .env and replace every placeholder value before running.
# Never commit your real .env file to version control.

# Django secret key — generate a value at https://djecrety.ir/
SECRET_KEY=your-secret-key-here

# Set to False in production
DEBUG=True

# PostgreSQL database name
POSTGRES_DB=signal_project_db

# PostgreSQL username
POSTGRES_USER=postgres_user

# PostgreSQL password — use a strong value in production
POSTGRES_PASSWORD=your-strong-password-here

# Database host.
# When running inside Docker Compose use the service name: db
# When running locally against a native PostgreSQL use: localhost
DB_HOST=db

# PostgreSQL port
DB_PORT=5432